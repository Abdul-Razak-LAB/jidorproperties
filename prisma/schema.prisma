// Prisma schema for Neon Postgres
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  role         String   @default("user")
  name         String?
  phone        String?
  verifiedAt   DateTime?
  profileMeta  Json?
  properties   Property[]
  verificationTokens VerificationToken[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Property {
  id         String   @id @default(uuid())
  agent      User?    @relation(fields: [agentId], references: [id])
  agentId    String?
  title      String
  description String?
  propertyType String?
  status     String   @default("draft")
  price      Decimal?
  currency   String   @default("USD")
  address    Json?
  location   Json?
  bedrooms   Int?
  bathrooms  Int?
  areaSqm    Float?
  amenities  Json?
  metadata   Json?
  images     PropertyImage[]
  messages   Message[]
  createdAt  DateTime @default(now())
  publishedAt DateTime?
}

model PropertyImage {
  id         String   @id @default(uuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  url        String
  caption    String?
  sortOrder  Int      @default(0)
}

model Message {
  id        String   @id @default(uuid())
  fromId    String
  toId      String
  property  Property? @relation(fields: [propertyId], references: [id])
  propertyId String?
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
}

model EmailQueue {
  id              String   @id @default(uuid())
  to              String
  templateId      String?
  variables       Json?
  status          String   @default("pending")
  resendMessageId String?
  createdAt       DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  type      String   // 'verify' or 'reset'
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
